<Window
    x:Class="OctoFixFlow.WellSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OctoFixFlow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WellSelectionWindow"
    Width="760"
    Height="650"
    Background="#F0F0F0"
    ResizeMode="NoResize"
    mc:Ignorable="d">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部提示  -->
        <TextBlock
            Margin="0,0,0,10"
            FontSize="14"
            Foreground="#555"
            Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=StepDetailSelectdWellsWindowTitle}" />

        <!--  孔位选择区域  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="WellGrid"
                Margin="0,0,0,10"
                Background="White">
                <!--  动态生成96孔板  -->
            </Grid>
        </ScrollViewer>

        <!--  底部按钮  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="ClearBtn"
                Width="90"
                Height="32"
                Margin="0,0,15,0"
                Click="ClearBtn_Click"
                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=WindowOneclickdeletion}"
                Style="{StaticResource ActionButtonStyle}" />
            <Button
                x:Name="OkBtn"
                Width="90"
                Height="32"
                Margin="0,0,10,0"
                Click="OkBtn_Click"
                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingConfirm}"
                IsDefault="True"
                Style="{StaticResource ActionButtonStyle}" />
            <Button
                x:Name="CancelBtn"
                Width="90"
                Height="32"
                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=WindowLoginCancel}"
                IsCancel="True"
                Style="{StaticResource ActionButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
