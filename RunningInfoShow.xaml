<UserControl
    x:Class="OctoFixFlow.RunningInfoShow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OctoFixFlow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1300"
    d:DesignWidth="750"
    mc:Ignorable="d">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="55" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0">
            <TextBlock
                Margin="20,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Foreground="{StaticResource PrimaryColor}"
                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=RunningTitle}" />
        </Border>
        <Border
            Grid.Row="1"
            Height="1"
            HorizontalAlignment="Stretch"
            Background="#E0E0E0" />
        <Grid
            Grid.Row="2"
            Margin="10"
            Background="#FCFCFC">
            <Border
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="5">
                <StackPanel Margin="15">
                    <TextBlock
                        Margin="0,0,0,15"
                        FontSize="16"
                        FontWeight="Medium"
                        Foreground="{StaticResource PrimaryColor}"
                        Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=GuideBtnProtocolInfo}" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock
                                Margin="0,0,0,15"
                                FontSize="16"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryColor}"
                                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=GuideBtnExperimentProtocolInfoName}" />
                            <TextBox
                                x:Name="guideProtocolNameTextBox"
                                Height="30"
                                Margin="0,0,15,0"
                                IsEnabled="False"
                                Style="{StaticResource InputTextBoxStyle}"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock
                                Margin="0,0,0,15"
                                FontSize="16"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryColor}"
                                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=GuideBtnExperimentProtocolInfoAuthor}" />
                            <TextBox
                                x:Name="guideProtocolAuthorTextBox"
                                Height="30"
                                Margin="0,0,15,0"
                                IsEnabled="False"
                                Style="{StaticResource InputTextBoxStyle}"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,15"
                                FontSize="16"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryColor}"
                                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=RunningStartTime}" />
                            <TextBox
                                x:Name="guideProtocolStartTimeTextBox"
                                Height="30"
                                Margin="0,0,15,0"
                                IsEnabled="False"
                                Style="{StaticResource InputTextBoxStyle}"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                            <TextBlock
                                Margin="0,0,0,15"
                                FontSize="16"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryColor}"
                                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=GuideBtnExperimentProtocolInfoDescription}" />
                            <TextBox
                                x:Name="guideProtocolDescriptionTextBox"
                                Height="30"
                                AcceptsReturn="True"
                                IsEnabled="False"
                                Style="{StaticResource InputTextBoxStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <Grid
            Grid.Row="3"
            Margin="10"
            Background="#FCFCFC">
            <Border
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="5">
                <StackPanel Margin="15">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Medium"
                        Foreground="{StaticResource PrimaryColor}"
                        Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=RunningTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                Margin="0,0,0,15"
                                FontSize="16"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryColor}"
                                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=RunningDeviceStatus}" />
                            <TextBox
                                x:Name="StatusText"
                                Height="30"
                                Margin="0,0,15,0"
                                IsEnabled="False"
                                Style="{StaticResource InputTextBoxStyle}"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                Margin="0,0,0,15"
                                FontSize="16"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryColor}"
                                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=RunningRunningTime}" />
                            <TextBox
                                x:Name="RunTimeText"
                                Height="30"
                                Margin="0,0,15,0"
                                IsEnabled="False"
                                Style="{StaticResource InputTextBoxStyle}"
                                TextWrapping="NoWrap" />
                            <StackPanel
                                Margin="0,20,0,0"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="btnPause"
                                    Width="180"
                                    Height="180"
                                    Click="BtnPause_Click"
                                    Style="{StaticResource ActionButtonStyle}">
                                    <Image Source="/OctoFixFlow;component/images/start.png" Stretch="Uniform" />
                                </Button>
                                <!--  停止按钮（搭配你的停止图标）  -->
                                <Button
                                    x:Name="btnStop"
                                    Width="180"
                                    Height="180"
                                    Click="BtnStop_Click"
                                    Style="{StaticResource ActionButtonStyle}">
                                    <Image Source="/OctoFixFlow;component/images/stop.png" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Margin="0,0,0,15"
                                FontSize="16"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryColor}"
                                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=RunningRunningProgress}"
                                Visibility="Collapsed" />
                            <!--  使用Grid包裹ProgressBar和TextBlock，实现文本重叠显示在进度条内部  -->
                            <Grid
                                Grid.Row="1"
                                Height="30"
                                Margin="0,0,0,5"
                                Visibility="Collapsed">
                                <ProgressBar
                                    x:Name="RunProgressBar"
                                    Background="#ECF0F1"
                                    Foreground="#3498DB"
                                    Maximum="100"
                                    Value="30" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="#2C3E50"
                                    Text="{Binding ElementName=RunProgressBar, Path=Value, StringFormat={}{0:F0}%}" />
                            </Grid>
                            <ScrollViewer
                                Height="300"
                                Grid.Row="2"
                                Background="White"
                                BorderBrush="#BDC3C7"
                                BorderThickness="1">
                                <StackPanel Margin="10">
                                    <!--  运行日志  -->
                                    <TextBlock
                                        Margin="0,10,0,5"
                                        FontWeight="Bold"
                                        Text="运行日志:" />
                                    <ListBox
                                        x:Name="RunLogListBox"
                                        Height="auto"
                                        Background="White"
                                        BorderThickness="0"
                                        ItemsSource="{Binding RunLogs}"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="0,2"
                                                    Text="{Binding}"
                                                    TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>


                        </Grid>

                    </Grid>

                </StackPanel>
            </Border>
        </Grid>
        <!--  关闭按钮  -->
        <Button
            Grid.Row="4"
            Width="70"
            Height="35"
            Margin="0,10"
            Click="ExitRunningClick"
            Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualClose}"
            Style="{StaticResource ActionButtonStyle}" />
    </Grid>
</UserControl>
