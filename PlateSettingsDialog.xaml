                                        FontSize="13"
                                        Foreground="#666666"
                                        Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualZCoordinate}" />
                                    <TextBox
                                        x:Name="txtPlateZ"
                                        Grid.Column="7"
                                        Style="{StaticResource InputTextBoxStyle}"
                                        Text="0.00" />
                                </Grid>

                                <!--  3. 移动与保存按钮  -->
                                <StackPanel
                                    Margin="0,10,0,5"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                                    <StackPanel Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                x:Name="btnMoveToPlate"
                                                Click="MoveToPlate_Click"
                                                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualMovetoPlatePosition}"
                                                Style="{StaticResource ActionButtonStyle}" />
                                            <Button
                                                x:Name="btnDownToPlate"
                                                Margin="10,0,0,0"
                                                Click="DownToPlate_Click"
                                                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualMoveZaxis}"
                                                Style="{StaticResource ActionButtonStyle}" />
                                            <Button
                                                x:Name="btnSavePlatePos"
                                                Margin="10,0,0,0"
                                                Click="SavePlatePos_Click"
                                                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualSaveCoordinates}"
                                                Style="{StaticResource ActionButtonStyle}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                x:Name="btnResetX"
                                                Click="btnResetX_Click"
                                                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualResetX}"
                                                Style="{StaticResource ActionButtonStyle}" />
                                            <Button
                                                x:Name="btnResetY"
                                                Margin="10,0,0,0"
                                                Click="btnResetY_Click"
                                                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualResetY}"
                                                Style="{StaticResource ActionButtonStyle}" />
                                            <Button
                                                x:Name="btnResetZ"
                                                Margin="10,0,0,0"
                                                Click="btnResetZ_Click"
                                                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualResetZ}"
                                                Style="{StaticResource ActionButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <!--  左侧：跳跃尺寸区域  -->
                                        <StackPanel>
                                            <Border
                                                Background="White"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                                <StackPanel Margin="12" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Margin="0,0,0,8"
                                                        FontSize="14"
                                                        Foreground="#666666"
                                                        Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualCoordinateFineAdjustment}" />
                                                    <!--  单选按钮组（互斥选择）  -->
                                                    <WrapPanel HorizontalAlignment="Left">
                                                        <RadioButton
                                                            Width="70"
                                                            Margin="2,0"
                                                            Click="JumpSizeRadio_Click"
                                                            Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualTinySize}"
                                                            GroupName="JumpSize"
                                                            IsChecked="True"
                                                            Style="{StaticResource JumpSizeRadioStyle}"
                                                            Tag="0.1 mm" />
                                                        <RadioButton
                                                            Width="70"
                                                            Margin="2,0"
                                                            Click="JumpSizeRadio_Click"
                                                            Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualSmallSize}"
                                                            GroupName="JumpSize"
                                                            Style="{StaticResource JumpSizeRadioStyle}"
                                                            Tag="1 mm" />
                                                        <RadioButton
                                                            Width="70"
                                                            Margin="2,0"
                                                            Click="JumpSizeRadio_Click"
                                                            Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualBigSize}"
                                                            GroupName="JumpSize"
                                                            Style="{StaticResource JumpSizeRadioStyle}"
                                                            Tag="10 mm" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!--  右侧：方向控制区域  -->
                                        <Border
                                            Margin="10,0,0,0"
                                            Background="White"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="5">

                                            <StackPanel
                                                Margin="12"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <StackPanel>
                                                    <TextBlock
                                                        Margin="0,0,0,8"
                                                        FontSize="14"
                                                        Foreground="#666666"
                                                        Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualCoordinateDirectionControl}" />
                                                    <!--  单选按钮组（互斥选择）  -->
                                                    <StackPanel HorizontalAlignment="Left">
                                                        <RadioButton
                                                            x:Name="jumpXYButton"
                                                            Width="110"
                                                            Margin="0,2"
                                                            Click="JumpDirectionXY_Click"
                                                            Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualXAndY}"
                                                            GroupName="JumpXYZ"
                                                            IsChecked="True"
                                                            Style="{StaticResource JumpSizeNoTipRadioStyle}" />
                                                        <RadioButton
                                                            x:Name="jumpZButton"
                                                            Width="110"
                                                            Margin="0,2"
                                                            Click="JumpDirectionZ_Click"
                                                            Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualZAxis}"
                                                            GroupName="JumpXYZ"
                                                            Style="{StaticResource JumpSizeNoTipRadioStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Margin="10,26,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0">
                                                            <ToggleButton
                                                                x:Name="JumpLeftButton"
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Margin="0,0,5,0"
                                                                Click="JumpLeftButton_Click"
                                                                Content="←"
                                                                Style="{StaticResource FlowButtonStyle}"
                                                                Tag="left" />
                                                        </Grid>
                                                        <Grid Grid.Column="1">
                                                            <StackPanel>
                                                                <ToggleButton
                                                                    x:Name="JumpUpButton"
                                                                    Margin="0,0,0,2.5"
                                                                    Click="JumpUpButton_Click"
                                                                    Content="↑"
                                                                    Style="{StaticResource FlowButtonStyle}"
                                                                    Tag="up" />
                                                                <ToggleButton
                                                                    x:Name="JumpDownButton"
                                                                    Margin="0,2.5,0,0"
                                                                    Click="JumpDownButton_Click"
                                                                    Content="↓"
                                                                    Style="{StaticResource FlowButtonStyle}"
                                                                    Tag="down" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid Grid.Column="2">
                                                            <ToggleButton
                                                                x:Name="JumpRightButton"
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Margin="5,0,0,0"
                                                                Click="JumpRightButton_Click"
                                                                Content="→"
                                                                Style="{StaticResource FlowButtonStyle}"
                                                                Tag="right" />
                                                        </Grid>

                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Margin="10,0,0,0">
                                                    <TextBlock
                                                        Margin="0,0,0,8"
                                                        FontSize="14"
                                                        Foreground="#666666" />
                                                    <!--  单选按钮组（互斥选择）  -->
                                                    <StackPanel HorizontalAlignment="Left">
                                                        <RadioButton
                                                            x:Name="jumpZ2Button"
                                                            Width="110"
                                                            Margin="0,2"
                                                            Click="JumpDirectionZ2_Click"
                                                            Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualZ2Axis}"
                                                            GroupName="JumpXYZ"
                                                            Style="{StaticResource JumpSizeNoTipRadioStyle}" />
                                                        <RadioButton
                                                            x:Name="jumpZ3Button"
                                                            Width="110"
                                                            Margin="0,2"
                                                            Click="JumpDirectionZ3_Click"
                                                            Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualZ3Axis}"
                                                            GroupName="JumpXYZ"
                                                            Style="{StaticResource JumpSizeNoTipRadioStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>


                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <!--  关闭按钮  -->
        <Button
            Grid.Row="3"
            Width="70"
            Height="35"
            Margin="0,10"
            Click="ExitSetClick"
            Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualClose}"
            Style="{StaticResource ActionButtonStyle}" />
    </Grid>

</UserControl>