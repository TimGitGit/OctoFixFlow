                                                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=SettingManualStopShaking}"
                                                Style="{StaticResource ActionButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </TabItem>
                        <TabItem Header="temp">
