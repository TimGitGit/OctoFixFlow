<Window
    x:Class="OctoFixFlow.QuickFlowWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OctoFixFlow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=QuickTitile}"
    Width="500"
    Height="550"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="InputTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#F9F9F9" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <!--  1. 样本数量  -->
        <Grid Grid.Row="0" Margin="0,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=QuickSampleQty}" />
            <TextBox
                x:Name="SampleCountTextBox"
                Grid.Column="1"
                Style="{StaticResource InputTextBoxStyle}"
                Text="1"
                TextChanged="SampleCountTextBox_TextChanged" />
        </Grid>

        <!--  2. 取头位置  -->
        <Grid Grid.Row="1" Margin="0,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=QuickTipPickPos}" />
            <ComboBox
                x:Name="TipPickPositionComboBox"
                Grid.Column="1"
                Style="{StaticResource InputComboBoxStyle}" />
            <CheckBox
                x:Name="ChangeTipOnCheckBox"
                Grid.Column="2"
                Margin="0,5"
                VerticalAlignment="Center"
                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=QuickFixed}"
                IsChecked="True" />
            <TextBox
                x:Name="TipOnWellTextBox"
                Grid.Column="3"
                Style="{StaticResource InputTextBoxStyle}"
                Text="1" />
        </Grid>

        <!--  3. 吸液设置  -->
        <Grid Grid.Row="2" Margin="0,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=QuickAspPos}" />
            <ComboBox
                x:Name="AspiratePositionComboBox"
                Grid.Column="1"
                Margin="0,0,10,0"
                Style="{StaticResource InputComboBoxStyle}" />
            <TextBox
                x:Name="AspirateVolumeTextBox"
                Grid.Column="2"
                Style="{StaticResource InputTextBoxStyle}"
                Text="50" />
            <TextBlock
                Grid.Column="3"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Text="μL" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="" />
            <CheckBox
                x:Name="ChangeAisCheckBox"
                Grid.Column="1"
                Margin="0,5"
                VerticalAlignment="Center"
                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=QuickFixed}"
                IsChecked="True" />
            <TextBox
                x:Name="AspirateWellTetBox"
                Grid.Column="2"
                Style="{StaticResource InputTextBoxStyle}"
                Text="1" />
            <TextBlock
                Grid.Column="3"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=QuickColumn}" />
        </Grid>

        <!--  4. 注液设置  -->
        <Grid Grid.Row="4" Margin="0,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=QuickDispPos}" />
            <ComboBox
                x:Name="DispensePositionComboBox"
                Grid.Column="1"
                Margin="0,0,10,0"
                Style="{StaticResource InputComboBoxStyle}" />
            <TextBox
                x:Name="DispenseVolumeTextBox"
                Grid.Column="2"
                Style="{StaticResource InputTextBoxStyle}"
                Text="50" />
            <TextBlock
                Grid.Column="3"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Text="μL" />
        </Grid>
        <!--  5. 换头和退头设置  -->
        <Grid Grid.Row="5" Margin="0,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=QuickTipChangeSettings}" />
            <CheckBox
                x:Name="ChangeTipCheckBox"
                Grid.Column="1"
                Margin="0,5"
                VerticalAlignment="Center"
                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=QuickTipChange}"
                IsChecked="True" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=QuickTipEjectPos}" />
            <ComboBox
                x:Name="TipEjectPositionComboBox"
                Grid.Column="3"
                Style="{StaticResource InputComboBoxStyle}" />
        </Grid>

        <!--  6. 液体选择  -->
        <Grid Grid.Row="6" Margin="0,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=QuickLiquidSelection}" />
            <ComboBox
                x:Name="LiquidComboBox"
                Grid.Column="1"
                DisplayMemberPath="name"
                ItemsSource="{Binding Liquids}"
                Style="{StaticResource InputComboBoxStyle}" />
        </Grid>

        <!--  按钮区域  -->
        <StackPanel
            Grid.Row="7"
            Margin="0,15,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                x:Name="GenerateButton"
                Click="GenerateButton_Click"
                Content="{Binding Source={x:Static local:ResourceHelper.Instance}, Path=QuickGenerate}"
                Style="{StaticResource ActionButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
